{
  "random_seed": 42,
  "stopwords_path": "data/stopwords_vi.txt",
  "output_dir": "benchmarks/results",
  "dataset_sizes": [10000, 100000],
  "scaling_sizes": [10000, 100000, 1000000],
  "indexing_thread_counts": [1, 2, 4, 8, 16],
  "concurrency_thread_counts": [1, 2, 4, 8, 16, 32, 64, 128],
  "queries_per_type": 1000,
