{
  "random_seed": 42,
  "stopwords_path": "data/stopwords_vi.txt",
  "output_dir": "benchmarks/results",
  "dataset_sizes": [10000],
  "scaling_sizes": [10000, 100000],
  "indexing_thread_counts": [1, 2, 4],
  "concurrency_thread_counts": [1, 2, 4, 8],
  "queries_per_type": 200,
  "warmup_queries": 20,
  "avg_doc_length": 150,
  "vocabulary_size": 10000,
  "num_topics": 50,
  "mixed_workload": {
    "keyword": 0.6,
    "phrase": 0.2,
    "boolean": 0.1,
    "fuzzy": 0.1
  },
  "stress": {
    "initial_threads": 1,
    "max_threads": 32,
    "step": 4,
    "queries_per_level": 100
  },
  "cache_cold_iterations": 5,
  "cache_warm_iterations": 200,
  "skip_large_datasets": true,
  "large_dataset_threshold": 500000
}
